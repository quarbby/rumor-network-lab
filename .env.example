# Local LM Studio: no API key required. Start its OpenAI-compatible server.
LLM_PROVIDER=local
LOCAL_LLM_MODEL=qwen2.5-7b-instruct-1m
LOCAL_LLM_BASE_URL=http://localhost:1234/v1

# For OpenRouter instead, set LLM_PROVIDER=openrouter and supply your own key.
OPENROUTER_MODEL=z-ai/glm-5.3-flashx
OPENROUTER_API_KEY=
