# Copy to .env in this package. .env is ignored by Git. Never put keys in JSON or HTML.
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=z-ai/glm-5.3-flashx
OPENROUTER_API_KEY=

# For an OpenAI-compatible local model, change LLM_PROVIDER to local.
# Jev still requires OPENROUTER_API_KEY when generation is local.
LOCAL_LLM_MODEL=
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
